@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon-circle">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
            </div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to your Give-AID account to manage donations and activities.</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" id="loginEmail" placeholder="name@example.com" autocomplete="email" required />
                <label for="loginEmail">Email Address</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" class="form-control" id="loginPassword" placeholder="Password" autocomplete="current-password" required />
                <label for="loginPassword">Password</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                    <label class="form-check-label small text-muted" for="rememberMeCheck">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-giveaid-primary w-100 py-2">
                Sign In
            </button>
        </form>

        <div class="auth-footer">
            Don't have an account? <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model?.ReturnUrl">Register here</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
